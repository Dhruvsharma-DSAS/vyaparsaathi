# Copy to vyaparsaathi-ai/.env for local development. On Render, set these in the service's Environment tab.

# AI keys for the Saathi chat. Set one or both; with both, the second is used if the first fails.
# Google AI Studio key (Gemini): https://aistudio.google.com > Get API key
GOOGLE_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# Which provider to try first: "gemini" (default) or "groq".
LLM_PROVIDER=gemini
# Optional model overrides.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Frontend origins allowed to call this API (comma-separated). Use "*" locally.
CORS_ORIGINS=*
