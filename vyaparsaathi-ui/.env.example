# Copy to vyaparsaathi-ui/.env for local development.
# On Vercel, add the same keys in Project Settings > Environment Variables.

# PostgreSQL connection string (Prisma Postgres, Neon, Supabase, Render Postgres or local).
# Example for a local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyaparsaathi"
DATABASE_URL=""

# Public URL of the Python API (the Render service). Locally: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
